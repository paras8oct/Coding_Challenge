{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "types": ["node", "express", "jest"],
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],      // ✅ Only include files inside ./src
  "exclude": ["node_modules", "dist", "jest.config.ts"]  // ✅ Explicitly exclude jest.config.ts
}
